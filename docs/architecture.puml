@startuml state
    [*] --> init
    init --> idle
    idle --> recvPacket
    
    
    

    state "incoming packet" as recvPacket {
        [*] -d-> decHeader

        decHeader -d-> handelProtAudio : format_SR = 0x00
        decHeader -d-> handelProtSerial : format_SR = 0x20
        decHeader -d-> handelProtTxt : format_SR = 0x40
        decHeader -d-> handelProtService : format_SR = 0x60
        
        decHeader -d-> [*] : abort
        handelProtAudio -d-> [*]
        handelProtSerial -d-> [*]
        handelProtTxt -d-> [*]
        handelProtService -d-> [*]

        state "decode header" as decHeader{
            decHeader : check FOUC = 'VBAN'
            decHeader : get format_SR 
            decHeader : if FOURC not matches abort
        }
        state "handle protocol audio" as  handelProtAudio{

            state "decode audio header" as decAudioHeader {

                state "get sample rate" as protAudio_getSampleRate
                state "get number of samples" as prodAudio_getSampleCount
                state "get number of channels" as prodAudio_getChannelCount
                state "get data format" as protAudio_getDataFormat
                state "get codec" as prodAudio_getCodec
                state "get streamname" as prodAudio_getStreamName
                state "get frame number" as prodAudio_getFrameNumber
                
                state protAudio_checkStreamName <<choice>>
                state protAudio_checkContinuity <<choice>>
                state protAudio_checkSampleRate <<choice>>
                state protAudio_checkCodec <<choice>>


                [*] --> prodAudio_getStreamName
                prodAudio_getStreamName --> protAudio_checkStreamName
                protAudio_checkStreamName --> prodAudio_getCodec
                prodAudio_getCodec --> protAudio_checkCodec
                protAudio_checkCodec --> prodAudio_getFrameNumber
                prodAudio_getFrameNumber --> protAudio_checkContinuity
                protAudio_checkContinuity --> protAudio_getSampleRate
                protAudio_getSampleRate --> protAudio_checkSampleRate
                protAudio_checkSampleRate --> prodAudio_getSampleCount
                prodAudio_getSampleCount --> prodAudio_getChannelCount
                prodAudio_getChannelCount --> protAudio_getDataFormat
                protAudio_getDataFormat --> [*]

                protAudio_checkSampleRate --> [*] : sample rate not supported
                protAudio_checkContinuity --> [*] : out of sequence
                protAudio_checkStreamName --> [*] : not subed
                protAudio_checkCodec --> [*] : codec not supported
            }

            [*] -d-> decAudioHeader
            decAudioHeader -d-> handlePCM : codec = 0x00
            handlePCM -d-> putToBuffer
            putToBuffer -d-> [*]
            decAudioHeader -d-> [*] : aborted

            
            state "handle PCM" as handlePCM {
                handlePCM : seperate channels
                handlePCM : convert data to uint16_t format
            }
            
        }
        state "handle protocol serial" as  handelProtSerial{
            state "get stream name" as protSerial_getStreamName
            state protSerial_checkStreamName <<choice>>
            state "get Channel" as protSerial_getChannel
            state protSerial_checkChannel <<choice>>
            state "get frame couter" as protSerial_getFrameCounter
            state protSerial_checkSequence <<choice>>
            state "get baud rate" as protSerial_getBaudRate
            state "get COM-Port settings" as protSerial_getComSetting            
            state "get data format" as protSerial_getDataFormat
            
            

            state "configure serial" as protSerial_confSerialPort{

            }

            [*] --> protSerial_getStreamName
            protSerial_getStreamName --> protSerial_checkStreamName
            
            protSerial_checkStreamName --> [*] : not subed
            protSerial_checkStreamName --> protSerial_getChannel

            protSerial_getChannel --> protSerial_checkChannel
            protSerial_checkChannel --> [*] : not listed
            protSerial_checkChannel --> protSerial_getFrameCounter
            protSerial_getFrameCounter --> protSerial_checkSequence
            protSerial_checkSequence --> [*] : out of sequence 
            protSerial_checkSequence --> protSerial_getBaudRate
            protSerial_getBaudRate --> protSerial_getComSetting
            protSerial_getComSetting --> protSerial_getDataFormat
            

        }
        state "handle protocol txt" as  handelProtTxt{
            
        }
        state "handle protocol service" as  handelProtService{
            
        }
        
    }
    
@enduml